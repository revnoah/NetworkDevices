<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NetworkDevices" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/cyber_panel</item>
        <item name="colorPrimaryVariant">@color/cyber_black</item>
        <item name="colorOnPrimary">@color/cyber_cyan</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/cyber_magenta</item>
        <item name="colorSecondaryVariant">@color/cyber_cyan</item>
        <item name="colorOnSecondary">@color/cyber_black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/cyber_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
