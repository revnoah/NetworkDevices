# Machine-local SDK and signing configuration (including nested modules)
local.properties
key.properties
keystore.properties
*.jks
*.keystore

# Gradle, Kotlin, and native build caches
.gradle/
.kotlin/
.externalNativeBuild/
.cxx/

# Generated build output; retain source directories named build
**/build/
!**/src/**/build/
captures/
*.apk
*.aab
*.ap_
*.dex
*.hprof

# Machine-local Android Studio state; retain shared project settings
*.iml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetDropDown.xml
.idea/deploymentTargetSelector.xml
.idea/androidTestResultsUserPreferences.xml
.idea/appInsightsSettings.xml

# OS metadata and editor temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# Local environment secrets; retain sanitized examples
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local assistant state and credentials
/.agents/
/.codex/
/.aws/

# Local blog draft generated by the Blog Post Draft skill
/blog-post.md
